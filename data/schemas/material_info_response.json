{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://api-test.example.com/schemas/material_info_response.json",
  "title": "物流-物料信息接口响应契约",
  "description": "物流-物料信息接口响应契约",
  "type": "object",
  "properties": {
    "code": {
      "type": "integer",
      "description": "业务状态码（20000 表示成功）"
    },
    "message": {
      "type": "string",
      "description": "提示信息",
      "minLength": 1,
      "maxLength": 200
    },
    "data": {
      "type": [
        "array",
        "object",
        "null"
      ],
      "description": "物料信息"
    },
    "translate_language": {
      "type": "string",
      "description": "多语言标识",
      "enum": [
        "zh-CN",
        "en-US"
      ]
    },
    "queryTime": {
      "type": "string",
      "description": "查询时间"
    }
  },
  "additionalProperties": true,
  "required": [
    "code"
  ]
}