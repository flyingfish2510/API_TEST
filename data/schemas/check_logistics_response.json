{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://api-test.example.com/schemas/check_logistics_response.json",
  "title": "物流-物流状态查询接口响应契约",
  "description": "物流-物流状态查询接口响应契约",
  "type": "object",
  "properties": {
    "code": {
      "type": "integer",
      "description": "业务状态码（20000 表示成功）"
    },
    "message": {
      "type": "string",
      "description": "提示信息",
      "minLength": 1,
      "maxLength": 200
    },
    "data": {
      "description": "业务数据"
    },
    "translate_language": {
      "type": "string",
      "description": "多语言标识",
      "enum": [
        "zh-CN",
        "en-US"
      ]
    },
    "queryTime": {
      "type": [
        "string",
        "null"
      ],
      "description": "查询时间"
    },
    "status": {
      "type": [
        "string",
        "integer"
      ],
      "description": "物流状态（0 待发货）"
    }
  },
  "additionalProperties": true,
  "required": [
    "code",
    "status"
  ]
}